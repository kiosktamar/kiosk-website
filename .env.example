# Neon PostgreSQL pooled connection string for runtime (server name contains -pooler)
DATABASE_URL=""

# Neon PostgreSQL direct connection string for Prisma CLI / Migrations (no -pooler)
DIRECT_URL=""

# Random string with at least 32 characters for signing JWT sessions (HS256)
JWT_SECRET=""

# Admin phone number (10 digits starting with 05, e.g. 0500000000) for seed script
ADMIN_PHONE=""

# Initial admin password (at least 12 characters) for seed script
ADMIN_PASSWORD=""

# Node environment (development, production, test)
NODE_ENV="development"

# (Only in .env.test) Substring present in Neon test branch endpoint hostname to prevent accidental wipes
NEON_TEST_BRANCH_HINT=""
