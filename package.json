{
  "name": "kiosk-tamar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "dotenv -e .env.test -- vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.67.2",
    "bcryptjs": "3.0.3",
    "jose": "6.2.2",
    "lucide-react": "1.16.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "dotenv": "16.4.7",
    "dotenv-cli": "8.0.0",
    "eslint": "9.22.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.5.3",
    "prisma": "7.10.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
