generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum OrderStatus {
  PENDING
  READY
  PAID
  CANCELED
}

enum StockStatus {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
}

enum ProductType {
  SINGLE
  COMBO
}

enum ToppingKind {
  TOPPING
  SAUCE
}

enum PaymentMethod {
  CASH
  VOUCHER
}

model Users {
  user_id            Int       @id @default(autoincrement())
  phone              String    @unique @db.VarChar(10)
  full_name          String    @db.VarChar(40)
  password_hash      String    @db.VarChar(60)
  role               Role      @default(STUDENT)
  is_active          Boolean   @default(true)
  token_version      Int       @default(0)
  failed_login_count Int       @default(0)
  locked_until       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  orders             Orders[]
}

model Categories {
  category_id     Int               @id @default(autoincrement())
  name            String            @unique @db.VarChar(30)
  sort_order      Int               @default(0)
  allows_toppings Boolean
  allows_sauces   Boolean
  products        Products[]
  combo_choices   ComboComponents[] @relation("ComboChoiceCategory")
}

model Products {
  product_id       Int               @id @default(autoincrement())
  category_id      Int
  name             String            @db.VarChar(40)
  description      String?           @db.VarChar(150)
  price_agorot     Int
  product_type     ProductType       @default(SINGLE)
  accepts_voucher  Boolean           @default(false)
  stock_status     StockStatus       @default(IN_STOCK)
  stock_count      Int?
  is_archived      Boolean           @default(false)
  sort_order       Int               @default(0)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  category         Categories        @relation(fields: [category_id], references: [category_id], onDelete: Restrict)
  toppings         ProductToppings[]
  combo_components ComboComponents[] @relation("ComboOwner")
  fixed_in_combos  ComboComponents[] @relation("ComboFixedProduct")
  order_items      OrderItems[]

  @@unique([category_id, name])
}

model Toppings {
  topping_id          Int                 @id @default(autoincrement())
  name                String              @db.VarChar(30)
  kind                ToppingKind
  extra_price_agorot  Int                 @default(0)
  is_available        Boolean             @default(true)
  sort_order          Int                 @default(0)
  products            ProductToppings[]
  order_item_toppings OrderItemToppings[]

  @@unique([kind, name])
}

model ProductToppings {
  product_id Int
  topping_id Int
  product    Products @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  topping    Toppings @relation(fields: [topping_id], references: [topping_id], onDelete: Cascade)

  @@id([product_id, topping_id])
}

model ComboComponents {
  component_id       Int         @id @default(autoincrement())
  combo_id           Int
  slot_label         String      @db.VarChar(20)
  fixed_product_id   Int?
  choice_category_id Int?
  sort_order         Int
  combo              Products    @relation("ComboOwner", fields: [combo_id], references: [product_id], onDelete: Cascade)
  fixed_product      Products?   @relation("ComboFixedProduct", fields: [fixed_product_id], references: [product_id], onDelete: Restrict)
  choice_category    Categories? @relation("ComboChoiceCategory", fields: [choice_category_id], references: [category_id], onDelete: Restrict)

  @@index([combo_id])
}

model KioskSettings {
  id              Int       @id @default(1)
  is_open         Boolean   @default(false)
  closes_at       DateTime? @db.Timestamptz(6)
  max_open_orders Int       @default(2)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)
}

model Orders {
  order_id        Int          @id @default(autoincrement())
  order_code      String       @unique @db.Char(4)
  user_id         Int
  status          OrderStatus  @default(PENDING)
  total_agorot    Int
  cash_due_agorot Int
  voucher_count   Int
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  ready_at        DateTime?    @db.Timestamptz(6)
  closed_at       DateTime?    @db.Timestamptz(6)
  user            Users        @relation(fields: [user_id], references: [user_id], onDelete: Restrict)
  items           OrderItems[]

  @@index([status, created_at])
  @@index([user_id, status])
}

model OrderItems {
  order_item_id     Int                 @id @default(autoincrement())
  order_id          Int
  parent_item_id    Int?
  product_id        Int
  product_name      String              @db.VarChar(40)
  unit_price_agorot Int
  quantity          Int
  payment_method    PaymentMethod?
  line_total_agorot Int
  order             Orders              @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  parent            OrderItems?         @relation("ComboChildren", fields: [parent_item_id], references: [order_item_id], onDelete: Cascade)
  children          OrderItems[]        @relation("ComboChildren")
  product           Products            @relation(fields: [product_id], references: [product_id], onDelete: Restrict)
  toppings          OrderItemToppings[]

  @@index([order_id])
  @@index([parent_item_id])
}

model OrderItemToppings {
  order_item_id      Int
  topping_id         Int
  topping_name       String     @db.VarChar(30)
  extra_price_agorot Int
  order_item         OrderItems @relation(fields: [order_item_id], references: [order_item_id], onDelete: Cascade)
  topping            Toppings   @relation(fields: [topping_id], references: [topping_id], onDelete: Restrict)

  @@id([order_item_id, topping_id])
}
